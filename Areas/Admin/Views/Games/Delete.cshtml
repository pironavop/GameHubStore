@model GameHubStore.Models.Entities.Game

@{
    ViewData["Title"] = "Delete Game";
}

<div class="container mt-4">
    <h2>Delete Game</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="alert alert-danger">
        Are you sure you want to delete this game?
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl"
                             style="width:160px;height:220px;object-fit:cover;border-radius:10px;" />
                    }
                </div>

                <div class="col-md-9">
                    <h4>@Model.Title</h4>
                    <p>@Model.Description</p>

                    <p>
                        <strong>Category:</strong> @Model.Category?.Name
                    </p>

                    <p>
                        <strong>Platforms:</strong>
                        @foreach (var gp in Model.GamePlatforms)
                        {
                            <span class="badge bg-info text-dark me-1">
                                @gp.Platform.Name
                            </span>
                        }
                    </p>

                    <p><strong>Price:</strong> ₹@Model.Price</p>
                    <p><strong>Stock:</strong> @Model.StockQuantity</p>
                </div>
            </div>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="Games" asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Yes, Delete</button>

        <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>