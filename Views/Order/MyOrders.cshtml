@model List<GameHubStore.Models.Entities.Order>

@{
    ViewData["Title"] = "My Orders";
}

<section class="orders-section py-5">
    <div class="container">
        <h1 class="fw-bold mb-4">My Orders</h1>

        @if (Model.Any())
        {
            <div class="cart-card">
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Order Status</th>
                            <th>Payment Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>₹@order.TotalAmount</td>
                                <td>@order.OrderStatus</td>
                                <td>@order.PaymentStatus</td>
                                <td class="text-end">
                                    <a asp-controller="Order"
                                       asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-outline-light">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="info-card">
                <h4>No orders yet.</h4>
                <p>Your purchased games will appear here.</p>

                <a asp-controller="Store" asp-action="Index" class="btn btn-neon">
                    Browse Store
                </a>
            </div>
        }
    </div>
</section>