@model List<GameHubStore.Models.Entities.Wishlist>

@{
    ViewData["Title"] = "Wishlist";
}

<section class="library-section py-5">
    <div class="container">

        <h1 class="fw-bold mb-4">
            ❤️ My Wishlist
        </h1>

        @if (Model.Any())
        {
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-md-4">

                        <div class="store-game-card">

                            <div class="store-game-image">
                                <img src="@item.Game.CoverImageUrl" />
                            </div>

                            <div class="store-game-body">

                                <span class="game-category">
                                    @item.Game.Category?.Name
                                </span>

                                <h5>@item.Game.Title</h5>

                                <div class="mt-3">

                                    <a asp-controller="Store"
                                       asp-action="Details"
                                       asp-route-id="@item.GameId"
                                       class="btn btn-neon-sm w-100 mb-2">
                                        View Game
                                    </a>


                                    <form asp-controller="Wishlist"
                                          asp-action="MoveToCart"
                                          method="post"
                                          class="mb-2">

                                        <input type="hidden"
                                               name="wishlistId"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-success w-100">
                                            Move To Cart
                                        </button>

                                    </form>


                                    <form asp-controller="Wishlist"
                                          asp-action="Remove"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger w-100">
                                            Remove
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="info-card">
                <h4>Your wishlist is empty.</h4>

                <a asp-controller="Store"
                   asp-action="Index"
                   class="btn btn-neon">
                    Browse Games
                </a>
            </div>
        }

    </div>
</section>