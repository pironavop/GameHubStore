@model GameHubStore.Models.Entities.Game

@{
    ViewData["Title"] = Model.Title;
}

<section class="game-details-section py-5">
    <div class="container">
        <a asp-controller="Store" asp-action="Index" class="btn btn-outline-light mb-4">
            ← Back to Store
        </a>

        <div class="game-details-card">
            <div class="row g-4">
                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl"
                             class="game-details-cover"
                             alt="@Model.Title" />
                    }
                    else
                    {
                        <div class="no-cover details-no-cover">No Image</div>
                    }
                </div>

                <div class="col-md-8">
                    <span class="game-category">@Model.Category?.Name</span>

                    <h1 class="mt-3">@Model.Title</h1>

                    <p class="text-light opacity-75">
                        Released on @Model.ReleaseDate.ToString("dd MMM yyyy")
                    </p>

                    <div class="platform-list mb-3">
                        @foreach (var gp in Model.GamePlatforms)
                        {
                            <span>@gp.Platform.Name</span>
                        }
                    </div>

                    <p class="game-description">
                        @Model.Description
                    </p>

                    <div class="details-price mb-4">
                        @if (Model.DiscountPrice.HasValue)
                        {
                            <span class="old-price me-2">₹@Model.Price</span>
                            <strong>₹@Model.DiscountPrice</strong>
                        }
                        else
                        {
                            <strong>₹@Model.Price</strong>
                        }
                    </div>

                    <p>
                        <strong>Stock:</strong> @Model.StockQuantity keys available
                    </p>

                    <div class="d-flex gap-3 flex-wrap">
                        @if (Model.StockQuantity > 0)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="gameId" value="@Model.Id" />
                                <button type="submit" class="btn btn-neon">
                                    Add to Cart
                                </button>
                            </form>

                            <form asp-controller="Wishlist"
                                  asp-action="Add"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="gameId"
                                       value="@Model.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger">
                                    ❤️ Add to Wishlist
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary" disabled>
                                Out of Stock
                            </button>
                        }

                        @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                        {
                            <a href="@Model.TrailerUrl"
                               target="_blank"
                               class="btn btn-outline-light btn-lg">
                                Watch Trailer
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        









        <div class="game-details-card mt-4">
            <h3>Reviews & Ratings</h3>

            @{
                var avgRating = Model.Reviews.Any()
                ? Model.Reviews.Average(r => r.Rating)
                : 0;
            }

            <p class="text-light opacity-75">
                Average Rating:
                <strong>@avgRating.ToString("0.0") / 5</strong>
                (@Model.Reviews.Count reviews)
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">@TempData["Info"]</div>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-controller="Review" asp-action="Add" method="post" class="mb-4">
                    <input type="hidden" name="gameId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <select name="rating" class="form-select">
                            <option value="5">⭐⭐⭐⭐⭐ 5</option>
                            <option value="4">⭐⭐⭐⭐ 4</option>
                            <option value="3">⭐⭐⭐ 3</option>
                            <option value="2">⭐⭐ 2</option>
                            <option value="1">⭐ 1</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Comment</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Write your review..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-neon-sm">
                        Submit Review
                    </button>
                </form>
            }
            else
            {
                <p>
                    <a asp-controller="Account" asp-action="Login">Login</a> to write a review.
                </p>
            }

            @if (Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div class="review-card">
                        <div class="d-flex justify-content-between">
                            <strong>@review.User.FullName</strong>
                            <span>@review.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>

                        <div class="review-stars">
                            @for (int i = 1; i <= review.Rating; i++)
                            {
                                <span>⭐</span>
                            }
                        </div>

                        <p>@review.Comment</p>

                        @if (User.Identity != null && User.Identity.Name == review.User.Email)
                        {
                            <form asp-controller="Review" asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@review.Id" />
                                <input type="hidden" name="gameId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete Review
                                </button>
                            </form>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-light opacity-75">No reviews yet. Be the first to review this game.</p>
            }
        </div>
    </div>
</section>