@model GameHubStore.Models.Entities.Cart

@{
    ViewData["Title"] = "My Cart";

    var totalAmount = Model.CartItems.Sum(x => x.UnitPrice * x.Quantity);
}

<section class="cart-section py-5">
    <div class="container">
        <h1 class="fw-bold mb-4">My Cart</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">@TempData["Info"]</div>
        }

        @if (Model.CartItems.Any())
        {
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="cart-card">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="cart-item">
                                <div class="cart-item-image">
                                    @if (!string.IsNullOrEmpty(item.Game.CoverImageUrl))
                                    {
                                        <img src="@item.Game.CoverImageUrl" alt="@item.Game.Title" />
                                    }
                                    else
                                    {
                                        <div class="no-cover">No Image</div>
                                    }
                                </div>

                                <div class="cart-item-info">
                                    <h5>@item.Game.Title</h5>
                                    <p class="text-light opacity-75">Quantity: @item.Quantity</p>
                                    <strong>₹@(item.UnitPrice * item.Quantity)</strong>
                                </div>

                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <form asp-controller="Cart" asp-action="Clear" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-light">
                            Clear Cart
                        </button>
                    </form>
                </div>

                <div class="col-md-4">
                    <div class="cart-summary">
                        <h4>Order Summary</h4>

                        <div class="d-flex justify-content-between mt-4">
                            <span>Total Items</span>
                            <strong>@Model.CartItems.Count</strong>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <span>Total Amount</span>
                            <strong>₹@totalAmount</strong>
                        </div>

                        <hr />

                        <a href="#" class="btn btn-neon w-100">
                            Proceed to Checkout
                        </a>

                        <a asp-controller="Store" asp-action="Index" class="btn btn-outline-light w-100 mt-2">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="info-card">
                <h4>Your cart is empty.</h4>
                <p>Explore the store and add your favorite games.</p>

                <a asp-controller="Store" asp-action="Index" class="btn btn-neon">
                    Browse Store
                </a>
            </div>
        }
    </div>
</section>